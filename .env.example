# Публичные ключи. Их можно видеть в браузере.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Только сервер и скрипты. Не добавляйте в клиентский код и не коммитьте настоящий ключ.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Адрес сайта для ссылок в письмах Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Первый администратор. Используется только командой npm run create-admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_FIRST_NAME=Администратор
ADMIN_LAST_NAME=Сервиса
ADMIN_PHONE=+79897680707

# Демонстрационные данные. Скрипт откажется работать, если флаг не true.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=change-me-demo
